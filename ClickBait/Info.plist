<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ClickBait</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>ClickBait controls Finder, Notes and System Events to carry out your commands, like making a note or switching Dark Mode, and Music or Spotify from its notch panel.</string>
	<key>NSCameraUsageDescription</key>
	<string>ClickBait shows your camera in its notch Mirror while you have it open. Nothing is recorded or saved.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 ClickBait contributors. Apache License 2.0.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ClickBait listens while you hold Control+Option so it can hear your question, or fn+Control so it can type what you say.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>ClickBait adds reminders when you ask it to. It never reads your existing reminders.</string>
	<key>NSRemindersUsageDescription</key>
	<string>ClickBait adds reminders when you ask it to.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Remember with ClickBait</string>
			</dict>
			<key>NSMessage</key>
			<string>rememberSelection</string>
			<key>NSPortName</key>
			<string>ClickBait</string>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
